{
  "name": "@saalt/plugin-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && npm run build:federated",
    "build:federated": "vite build --config vite.federated.ts",
    "dev": "NODE_TLS_REJECT_UNAUTHORIZED=0 react-router dev --port 8080",
    "start": "PORT=8080 react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@module-federation/vite": "^1.9.1",
    "@open-agent-kit/bridge": "1.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-router/node": "7.16.0",
    "@react-router/serve": "7.16.0",
    "@saalt/saalt-ui": "0.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "isbot": "^5.1.27",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "7.16.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@react-router/dev": "7.16.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^24",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "sass-embedded": "^1.93.2",
    "tailwindcss": "^4.1.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
